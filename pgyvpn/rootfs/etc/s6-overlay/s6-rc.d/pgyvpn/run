#!/command/with-contenv bash
# shellcheck shell=bash
# 启动蒲公英客户端守护进程（取代原 OpenRC 的 `service pgyvpn start`）。
# 不使用 bashio：s6 的 run 脚本不会自动加载 bashio 库，直接 echo 更可靠。
set -e

OPTIONS_FILE="/data/options.json"
CONFIG_FILE="/etc/oray/pgyvpn/config.ini"

if [[ ! -r "${OPTIONS_FILE}" ]]; then
    echo "[pgyvpn] ERROR: 找不到 Home Assistant 配置文件：${OPTIONS_FILE}"
    exit 1
fi

if ! PGY_USERNAME="$(jq -er '.username | strings | select(length > 0)' "${OPTIONS_FILE}")"; then
    echo "[pgyvpn] ERROR: 请在加载项配置中填写蒲公英账号或 UID。"
    exit 1
fi

if ! PGY_PASSWORD="$(jq -er '.password | strings | select(length > 0)' "${OPTIONS_FILE}")"; then
    echo "[pgyvpn] ERROR: 请在加载项配置中填写蒲公英密码。"
    exit 1
fi

if [[ ! -c /dev/net/tun ]]; then
    echo "[pgyvpn] ERROR: 容器内未找到 /dev/net/tun；请确认 HAOS 内核启用了 TUN 设备。"
    exit 1
fi

mkdir -p /data/pgyvpn /data/oray-log/pgyvpn /var/log/oray

if [[ ! -s "${CONFIG_FILE}" ]]; then
    echo "[pgyvpn] ERROR: 客户端配置缺失：${CONFIG_FILE}"
    exit 1
fi

echo "[pgyvpn] 正在启动蒲公英客户端守护进程（账号：${PGY_USERNAME}）。"

# 前台运行，交给 s6 监管；异常退出由 s6 自动重启。
# 注意不要用 -d（守护化），否则 s6 监管的会是一个立刻退出的父进程。
exec /usr/sbin/pgyvpn_svr \
    -R -A --mlink -t \
    -i pgy-api.oray.com \
    -K 255.255.255.255 \
    -p /var/log/oray/pgyvpn_svr \
    -f "${CONFIG_FILE}" \
    --logmask 0xFFFFFFF7
